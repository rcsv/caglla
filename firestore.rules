rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection rules
    match /users/{userId} {
      // Public read: allow reading user profiles (e.g., slug, name) for routing and cards
      allow read: if true;

      // Write restricted to the owner
      allow write: if request.auth != null &&
        (request.auth.uid == resource.data.google_id ||
         request.auth.uid == userId);

      // Allow creation for new users
      allow create: if request.auth != null &&
        (request.auth.uid == request.resource.data.google_id ||
         request.auth.uid == userId);
    }
    
    // Trips collection rules
    match /trips/{tripId} {
      // Trip owner can read and write
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.user_id;
      
      // Allow creation for authenticated users
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.user_id;
      
      // Public trips can be read by anyone
      allow read: if resource.data.access_level == 'public';
      
      // Check if user has access through trip_users collection
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/trip_users/$(tripId + '_' + request.auth.uid));

      // likes subcollection is server-managed; expose read-only for public trips
      match /likes/{likeUserId} {
        allow read: if get(/databases/$(database)/documents/trips/$(tripId)).data.access_level == 'public';
        allow write: if false;
      }
    }
    
    // Days collection rules
    match /days/{dayId} {
      // Users can access days if they have access to the parent trip
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/trips/$(resource.data.trip_id)) &&
        (request.auth.uid == get(/databases/$(database)/documents/trips/$(resource.data.trip_id)).data.user_id ||
         get(/databases/$(database)/documents/trips/$(resource.data.trip_id)).data.access_level == 'public' ||
         exists(/databases/$(database)/documents/trip_users/$(resource.data.trip_id + '_' + request.auth.uid)));
      
      // Allow creation for trip owners
      allow create: if request.auth != null && 
        exists(/databases/$(database)/documents/trips/$(request.resource.data.trip_id)) &&
        request.auth.uid == get(/databases/$(database)/documents/trips/$(request.resource.data.trip_id)).data.user_id;
    }
    
    // Itineraries collection rules
    match /itineraries/{itineraryId} {
      // Users can access itineraries if they have access to the parent day's trip
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/days/$(resource.data.day_id)) &&
        exists(/databases/$(database)/documents/trips/$(get(/databases/$(database)/documents/days/$(resource.data.day_id)).data.trip_id)) &&
        (request.auth.uid == get(/databases/$(database)/documents/trips/$(get(/databases/$(database)/documents/days/$(resource.data.day_id)).data.trip_id)).data.user_id ||
         get(/databases/$(database)/documents/trips/$(get(/databases/$(database)/documents/days/$(resource.data.day_id)).data.trip_id)).data.access_level == 'public' ||
         exists(/databases/$(database)/documents/trip_users/$(get(/databases/$(database)/documents/days/$(resource.data.day_id)).data.trip_id + '_' + request.auth.uid)));
      
      // Allow creation for trip owners
      allow create: if request.auth != null && 
        exists(/databases/$(database)/documents/days/$(request.resource.data.day_id)) &&
        exists(/databases/$(database)/documents/trips/$(get(/databases/$(database)/documents/days/$(request.resource.data.day_id)).data.trip_id)) &&
        request.auth.uid == get(/databases/$(database)/documents/trips/$(get(/databases/$(database)/documents/days/$(request.resource.data.day_id)).data.trip_id)).data.user_id;
    }
    
    // Trip users collection rules (for sharing)
    match /trip_users/{tripUserId} {
      // Trip owners can manage shared users
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/trips/$(resource.data.trip_id)) &&
        request.auth.uid == get(/databases/$(database)/documents/trips/$(resource.data.trip_id)).data.user_id;
      
      // Allow creation for trip owners
      allow create: if request.auth != null && 
        exists(/databases/$(database)/documents/trips/$(request.resource.data.trip_id)) &&
        request.auth.uid == get(/databases/$(database)/documents/trips/$(request.resource.data.trip_id)).data.user_id;
      
      // Shared users can read their own access records
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.user_id;
    }
    
    // Places cache collection rules (public read-only cache)
    match /places_cache/{placeId} {
      // Anyone can read and write cached place data (public cache)
      allow read, write: if true;
    }
    
    // User storage collection rules
    match /userStorage/{userId} {
      // Users can read and write their own storage usage data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow creation for authenticated users
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reservation templates collection rules
    match /reservation_templates/{templateId} {
      // Users can read and write their own templates
      allow read, write: if request.auth != null && request.auth.uid == resource.data.user_id;
      
      // Allow creation for authenticated users
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }
    
    // ============================================================================
    // v3.0.0 SNS機能コレクション
    // ============================================================================
    
    // Trip likes collection rules
    match /trip_likes/{likeId} {
      // 公開トリップのいいねは誰でも読める（認証不要）
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/trips/$(resource.data.trip_id)) &&
        get(/databases/$(database)/documents/trips/$(resource.data.trip_id)).data.access_level == 'public';
      
      // 書き込みはサーバー管理のみ（クライアントからの直接書き込みは禁止）
      // 注意: 実際のいいね処理はAPIルート経由でトランザクションで行う
      allow write: if false;
    }
    
    // Trip comments collection rules
    match /trip_comments/{commentId} {
      // 公開トリップのコメントは誰でも読める（認証不要）
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/trips/$(resource.data.trip_id)) &&
        get(/databases/$(database)/documents/trips/$(resource.data.trip_id)).data.access_level == 'public' &&
        resource.data.deleted == false; // 論理削除されたコメントは読めない
      
      // 認証済みユーザーは公開トリップにコメントを作成可能
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/trips/$(request.resource.data.trip_id)) &&
        get(/databases/$(database)/documents/trips/$(request.resource.data.trip_id)).data.access_level == 'public' &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.deleted == false;
      
      // コメントの作成者のみ更新・削除可能（論理削除）
      allow update: if request.auth != null &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.trip_id == resource.data.trip_id;
      
      // 物理削除は禁止（論理削除のみ）
      allow delete: if false;
    }
    
    // User follows collection rules
    match /user_follows/{followId} {
      // ユーザーは自分のフォロー関係を読める（存在する場合）
      allow read: if request.auth != null &&
        (resource == null ||
         resource.data.follower_id == request.auth.uid ||
         resource.data.following_id == request.auth.uid);
      
      // 認証済みユーザーは他のユーザーをフォロー可能（自分自身は除く）
      // 注意: set()はcreateとupdateの両方をチェックするため、createのみ許可
      allow create: if request.auth != null &&
        request.resource.data.follower_id == request.auth.uid &&
        request.resource.data.following_id != request.auth.uid;
      
      // 既存ドキュメントの更新は禁止（フォロー/アンフォローのみ）
      // 注意: set()で既存ドキュメントを更新しようとした場合は拒否
      allow update: if false;
      
      // フォロー解除（削除）はフォローした人のみ可能
      allow delete: if request.auth != null &&
        resource != null &&
        resource.data.follower_id == request.auth.uid;
    }
  }
}
