{
  "compilerOptions": {
    // -------------------------------------------------------------
    // ▼ 出力ターゲット
    // -------------------------------------------------------------
    // Next.js + モダンブラウザ + Node18/20 前提なら ES2022 が最適。
    // これより下げると非同期機能や最新構文が使えずデメリットしかない。
    "target": "es2022",

    // Next.js は SWC によるバンドル前提なので module は esnext。
    "module": "esnext",

    // -------------------------------------------------------------
    // ▼ モジュール解決
    // -------------------------------------------------------------
    // Next.js (Turbopack / SWC) と最も相性が良いのが bundler。
    // 公式テンプレにもこれが使われている。
    "moduleResolution": "bundler",

    // -------------------------------------------------------------
    // ▼ JSX
    // -------------------------------------------------------------
    // JSX は TypeScript に変換させず、Next.js(SWC) に任せる。
    // React 18 + App Router の場合 preserve 一択。
    "jsx": "preserve",

    // -------------------------------------------------------------
    // ▼ 型安全
    // -------------------------------------------------------------
    "strict": true,          // 最強の型安全。切る理由なし。
    "skipLibCheck": true,    // ライブラリ型チェックは重すぎるので高速化のため ON。
    "noEmit": true,          // Next.js が emit を担当するので TS は出力しない。

    // -------------------------------------------------------------
    // ▼ ファイル系
    // -------------------------------------------------------------
    // .js を TS プロジェクトに混ぜると型穴が生まれるので allowJs は false。
    "allowJs": false,

    // ts 拡張子で import する文化は Next.js と相性悪いので false。
    "allowImportingTsExtensions": false,

    // JSON import をよく使う場合のために有効化（Next.js とも相性良い）
    "resolveJsonModule": true,

    // -------------------------------------------------------------
    // ▼ incremental build
    // -------------------------------------------------------------
    // Next.js ビルドでは incremental がほぼ意味を持たず、
    // .tsbuildinfo の衝突バグも起こるため OFF 推奨。
    "incremental": false,

    // -------------------------------------------------------------
    // ▼ ライブラリ
    // -------------------------------------------------------------
    // esnext を指定することで最新の JS API を全て型で扱える。
    "lib": ["dom", "dom.iterable", "esnext"],

    // -------------------------------------------------------------
    // ▼ パスエイリアス
    // -------------------------------------------------------------
    // "@/xxx" でプロジェクトルートを指す Next.js 公式推奨パターン。
    "paths": {
      "@/*": ["./*"]
    },

    // -------------------------------------------------------------
    // ▼ 型定義
    // -------------------------------------------------------------
    // jest / node / react + カスタム ambient type を読み込む。
    "types": [
      "node",
      "react",
      "jest",
      "./lib/core/types/ambient-google-maps"
    ],

    // -------------------------------------------------------------
    // ▼ Next.js のためのプラグイン
    // -------------------------------------------------------------
    "plugins": [{ "name": "next" }]
  },

  // ---------------------------------------------------------------
  // ▼ include：チェック対象
  // ---------------------------------------------------------------
  // next-env.d.ts は必須。tsx/ts 全体、Next.js が生成する型も含める。
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],

  // ---------------------------------------------------------------
  // ▼ exclude：絶対に node_modules は外す！
  // ---------------------------------------------------------------
  // ここ消すと TS が node_modules までチェックして超重くなる。
  "exclude": ["node_modules"],

  // ---------------------------------------------------------------
  // ▼ ts-node 設定（スクリプト用途）
  // ---------------------------------------------------------------
  // API route とは独立して、CLI スクリプトを書く場合に便利。
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    },
    "require": ["tsconfig-paths/register"]
  }
}
