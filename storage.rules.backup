rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // === 機能フラグ：true にすると Firestore 参照のクォータチェックを有効化 ===
    function QUOTA_ENFORCED() { return false; }  // ← 今は無効（切り分け用）

    // ---- 公開ファイル（必要なら） ----
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null; // 運用に合わせて調整
    }

    // ---- 一時ファイル（temp/） ----
    match /temp/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // ---- ユーザー専用領域 ----
    match /users/{userId}/{allPaths=**} {

      // 読み取り（SDK 経由）※ downloadURL は別経路
      allow read: if request.auth != null && request.auth.uid == userId;

      // 作成・更新（アップロード／上書き）
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && isValidFileType()
        && isUnderFileSizeLimit()
        // 機能フラグが false の間は isUnderUserStorageQuota は呼ばれない（短絡評価）
        && ( !QUOTA_ENFORCED() || isUnderUserStorageQuota(userId) );

      // 削除（容量は減るだけなので権限のみ）
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ---- 旅行画像 ----
    match /trips/{tripId}/images/{fileName} {
      // 読み取り: 認証済みユーザーは読み取り可能（公開旅行は誰でも読み取り可能）
      allow read: if request.auth != null 
        || (exists(/databases/(default)/documents/trips/$(tripId)) 
            && get(/databases/(default)/documents/trips/$(tripId)).data.access_level == 'public');
      
      // 作成・更新（アップロード／上書き）: tripの所有者のみ
      // trips.user_idはFirebase Auth UID（users.google_id）を保存しているため、
      // request.auth.uidと直接比較
      allow create, update: if request.auth != null
        && exists(/databases/(default)/documents/trips/$(tripId))
        && isTripOwner(request.auth.uid, get(/databases/(default)/documents/trips/$(tripId)).data.user_id)
        && isValidFileType()
        && isUnderFileSizeLimit()
        // 機能フラグが false の間は isUnderUserStorageQuota は呼ばれない（短絡評価）
        && ( !QUOTA_ENFORCED() || isUnderUserStorageQuota(get(/databases/(default)/documents/trips/$(tripId)).data.user_id) );
      
      // 削除: tripの所有者のみ
      allow delete: if request.auth != null
        && exists(/databases/(default)/documents/trips/$(tripId))
        && isTripOwner(request.auth.uid, get(/databases/(default)/documents/trips/$(tripId)).data.user_id);
    }

    // ---- Google Places API 画像キャッシュ ----
    match /places-photos/{allPaths=**} {
      // 認証済みユーザーは読み取り・書き込み可能
      allow read, write: if request.auth != null;
    }

    // ------------- 共通ユーティリティ -------------

    // Tripの所有権を確認
    // trips.user_idはFirebase Auth UID（users.google_id）を保存しているため、
    // request.auth.uidと直接比較
    function isTripOwner(authUid, tripUserId) {
      return authUid == tripUserId;
    }

    // contentType の緩チェック（最終的にはサーバー側でも検証推奨）
    function isValidFileType() {
      return request.resource != null
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('application/pdf') ||
          request.resource.contentType.matches('text/.*')
        );
    }

    // 単一ファイルの上限（10MB）
    function isUnderFileSizeLimit() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024;
    }

    // ---- ユーザー合計クォータ（Phase 1） ----
    // QUOTA_ENFORCED() が true のときだけ評価される
    function isUnderUserStorageQuota(userId) {
      // 1) プラン取得
      let userDoc = get(/databases/(default)/documents/users/$(userId));
      let planId  = userDoc.exists() ? userDoc.data.plan_id : null;

      // 2) プラン上限（-1 = 無制限）
      let planDoc = get(/databases/(default)/documents/plans/$(planId));
      let userLimitBytes = planDoc.exists() ? planDoc.data.user_total_limit_bytes : -1;

      // 3) 現在の使用量
      let usageDoc = get(/databases/(default)/documents/storage_usage/$(userId));
      let used = usageDoc.exists() ? usageDoc.data.total_bytes : 0;

      // 4) 増分（上書き時は増えた分のみ。小さくなる上書きは0）
      let delta = deltaBytes();

      // 5) 判定
      return userLimitBytes == -1 || (used + delta) <= userLimitBytes;
    }

    // 増分バイト（create/update 時のみ呼ぶこと）
    function deltaBytes() {
      let oldSize = resource == null ? 0 : resource.size;
      let newSize = request.resource == null ? 0 : request.resource.size;
      return max(newSize - oldSize, 0);
    }
  }
}
