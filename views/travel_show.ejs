<!DOCTYPE html>
<html>
<head>
  <title><%= travel.title %></title>
</head>
<body>
  <p><a href="/travels">Back</a> | <a href="/logout">Logout</a></p>
  <h1><%= travel.title %></h1>
  <a href="/travels/<%= travel.id %>/edit">Edit</a>
  <form action="/travels/<%= travel.id %>/delete" method="post" style="display:inline">
    <button type="submit">Delete</button>
  </form>
  <h2>Itineraries</h2>
  <button id="openAddItineraryDialog">Add Itinerary</button>

  <dialog id="addItineraryDialog">
    <form id="addItineraryForm" method="dialog" data-travel-id="<%= travel.id %>">
      <input type="text" name="title" placeholder="Title" required><br>
      <textarea name="content" placeholder="Content" required></textarea><br>
      <button type="submit">Create</button>
      <button type="button" id="cancelAddItinerary">Cancel</button>
    </form>
  </dialog>

  <dialog id="editItineraryDialog">
    <form id="editItineraryForm" method="dialog">
      <input type="text" name="title" required><br>
      <textarea name="content" required></textarea><br>
      <button type="submit">Save</button>
      <button type="button" id="cancelEditItinerary">Cancel</button>
    </form>
  </dialog>

  <ul id="itineraryList">
    <% travel.itineraries.forEach(function(itinerary){ %>
      <li data-id="<%= itinerary.id %>">
        <a href="/travels/<%= travel.id %>/itineraries/<%= itinerary.id %>"><%= itinerary.title %></a>
        <button class="editItineraryBtn">Edit</button>
        <button class="deleteItineraryBtn">Delete</button>
      </li>
    <% }); %>
  </ul>
  <script src="/scripts/travel_show.js"></script>
</body>
</html>
