<!DOCTYPE html>
<html>
<head>
  <title><%= album.title %></title>
</head>
<body>
  <p><a href="/albums">Back</a> | <a href="/logout">Logout</a></p>
  <h1><%= album.title %></h1>
  <a href="/albums/<%= album.id %>/edit">Edit</a>
  <form action="/albums/<%= album.id %>/delete" method="post" style="display:inline">
    <button type="submit">Delete</button>
  </form>
  <h2>Pages</h2>
  <button id="openAddPageDialog">Add Page</button>

  <dialog id="addPageDialog">
    <form id="addPageForm" method="dialog" data-album-id="<%= album.id %>">
      <input type="text" name="title" placeholder="Title" required><br>
      <textarea name="content" placeholder="Content" required></textarea><br>
      <button type="submit">Create</button>
      <button type="button" id="cancelAddPage">Cancel</button>
    </form>
  </dialog>

  <dialog id="editPageDialog">
    <form id="editPageForm" method="dialog">
      <input type="text" name="title" required><br>
      <textarea name="content" required></textarea><br>
      <button type="submit">Save</button>
      <button type="button" id="cancelEditPage">Cancel</button>
    </form>
  </dialog>

  <ul id="pageList">
    <% album.pages.forEach(function(page){ %>
      <li data-id="<%= page.id %>">
        <a href="/albums/<%= album.id %>/pages/<%= page.id %>"><%= page.title %></a>
        <button class="editPageBtn">Edit</button>
        <button class="deletePageBtn">Delete</button>
      </li>
    <% }); %>
  </ul>
  <script src="/scripts/album_show.js"></script>
</body>
</html>
