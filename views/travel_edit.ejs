<!DOCTYPE html>
<html>
<head>
  <title>Edit Travel</title>
</head>
<body>
  <h1>Edit Travel</h1>
  <form action="/travels/<%= travel.id %>/edit" method="post">
    <input type="text" name="name" value="<%= travel.name %>" required><br>
    <textarea name="description"><%= travel.description %></textarea><br>
    <input type="text" name="destination" value="<%= travel.destination %>"><br>
    <input type="date" name="start_date" value="<%= travel.start_date %>"><br>
    <input type="date" name="end_date" value="<%= travel.end_date %>"><br>
    <button type="submit">Save</button>
  </form>
  <p><a href="/travels/<%= travel.id %>">Back</a></p>
</body>
</html>
