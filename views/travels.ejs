<!DOCTYPE html>
<html>
<head>
  <title>Your Travels</title>
</head>
<body>
  <p><a href="/">Home</a> | <a href="/logout">Logout</a></p>
  <h1>Travels</h1>
  <button id="openAddDialog">Create Travel</button>

  <dialog id="addDialog">
    <form id="addTravelForm" method="dialog">
      <input type="text" name="name" placeholder="Name" required><br>
      <textarea name="description" placeholder="Description"></textarea><br>
      <input type="text" name="main_venue" placeholder="Main Venue ID"><br>
      <input type="date" name="date_start"><br>
      <input type="date" name="date_end"><br>
      <button type="submit">Create</button>
      <button type="button" id="cancelAdd">Cancel</button>
    </form>
  </dialog>

  <ul id="travelList">
    <% travels.forEach(function(travel){ %>
      <li><a href="/travels/<%= travel.id %>"><%= travel.name %></a></li>
    <% }); %>
  </ul>
  <script src="/scripts/travels.js"></script>
</body>
</html>
