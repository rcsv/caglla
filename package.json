{
  "name": "caglla",
  "version": "2.3.0",
  "description": "Travel management app inspired by wanderlog",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --config=.config/jest.config.js",
    "test:watch": "jest --config=.config/jest.config.js --watch",
    "test:coverage": "jest --config=.config/jest.config.js --coverage",
    "test:firestore": "FIRESTORE_EMULATOR_HOST=localhost:8080 jest --config=.config/jest.firestore.config.js",
    "test:e2e": "playwright test --config=.config/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=.config/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config=.config/playwright.config.ts --headed",
    "test:all": "pnpm test && pnpm test:e2e",
    "emulators:start": "firebase emulators:start",
    "emulators:start:firestore": "firebase emulators:start --only firestore",
    "migrate": "ts-node src/migrate.ts",
    "flush-itineraries": "ts-node scripts/flush-itineraries.ts",
    "manage-itineraries": "ts-node scripts/manage-itineraries.ts",
    "simple-flush": "ts-node scripts/simple-flush.ts",
    "admin-flush": "ts-node scripts/admin-flush.ts",
    "api-flush": "ts-node scripts/api-flush.ts",
    "setup-secrets": "ts-node scripts/setup-secrets.ts",
    "generate:favicon": "node scripts/generate-favicon.js public/Cg-logo.svg",
    "recalculate:trip-stats": "ts-node scripts/recalculate-trip-stats.ts",
    "create-test-data": "ts-node scripts/create-test-data.ts",
    "create-dummy-trips": "ts-node scripts/create-dummy-trips.ts",
    "migrate-trip-user-ids": "ts-node scripts/migrate-trip-user-ids.ts",
    "analyze:price-level": "ts-node scripts/analyze-price-level-cache.ts",
    "refresh:price-level": "ts-node scripts/refresh-price-level-cache.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/secret-manager": "^6.1.1",
    "@googlemaps/js-api-loader": "1.16.10",
    "@iconify/react": "6.0.2",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.13.2",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^14.25.0",
    "mysql2": "^3.15.3",
    "next": "15.5.6",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@jest/test-sequencer": "^30.2.0",
    "@playwright/test": "^1.56.1",
    "@rcsv/typewise": "^0.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "dotenv": "^17.2.3",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.6",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "4.1.17",
    "to-ico": "^1.1.5",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "undici": "^7.16.0"
  },
  "volta": {
    "node": "22.20.0"
  }
}
